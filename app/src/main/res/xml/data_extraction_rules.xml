<?xml version="1.0" encoding="utf-8"?>
<!--
   Qué datos de la app NO se copian a los respaldos de Google ni al pasar a otro teléfono.
   Los reportes guardados sin internet (fotos y ubicación de menores), la copia del
   historial y la sesión son datos sensibles: se quedan solo en este teléfono.
   (Android 12 en adelante)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pendientes/" />
        <exclude domain="file" path="historial.json" />
        <exclude domain="sharedpref" path="sesion.xml" />
        <exclude domain="file" path="detalles/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pendientes/" />
        <exclude domain="file" path="historial.json" />
        <exclude domain="sharedpref" path="sesion.xml" />
        <exclude domain="file" path="detalles/" />
    </device-transfer>
</data-extraction-rules>
