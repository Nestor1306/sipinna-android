<?xml version="1.0" encoding="utf-8"?>
<!--
   Lo mismo que data_extraction_rules.xml, para Android 11 o anterior:
   los datos sensibles no se incluyen en los respaldos.
-->
<full-backup-content>
    <exclude domain="file" path="pendientes/" />
    <exclude domain="file" path="historial.json" />
    <exclude domain="sharedpref" path="sesion.xml" />
</full-backup-content>
